# Build/preview for the end-to-end tests: talk to the local Firebase emulators, never a real project.
VITE_FIREBASE_ENV=demo
VITE_EMULATORS=1
VITE_EMBED_ORIGIN=http://localhost:4174
# The resolver Worker: nothing listens here; the tests answer these requests themselves.
VITE_API_BASE_URL=http://127.0.0.1:8788
