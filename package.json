{
  "name": "post-saver-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @postsaver/web dev",
    "build": "pnpm --filter @postsaver/web --filter @postsaver/embed build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts --noEmit",
    "test": "pnpm -r run test",
    "test:rules": "pnpm --filter @postsaver/firebase test:rules",
    "test:e2e": "pnpm --filter @postsaver/e2e test:e2e",
    "check:domains": "tsx scripts/check-domains.ts",
    "brand": "tsx scripts/gen-brand.ts",
    "config:get": "tsx scripts/config-get.ts",
    "domain:apply": "tsx scripts/domain-apply.ts",
    "verify": "pnpm check:domains && pnpm typecheck && pnpm test && pnpm test:rules && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@postsaver/config": "workspace:*",
    "@types/node": "^26.6.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
